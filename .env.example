# VIMS / FlowCommand — Environment Configuration
# Copy this file to `.env` and configure real credentials before deploying.

# Server & Network Configuration
VIMS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Authentication & RBAC
VIMS_DEMO_OFFICER_PASSWORD=demo-pass-change-me
VIMS_ALLOW_DEMO_OTP=true
VIMS_DEMO_OTP=123456
VIMS_OTP_TTL_SECONDS=600

# RFC 6238 TOTP Configuration (Google / Microsoft Authenticator)
# Base32 secret key (16 characters) for generating time-based one-time passwords
VIMS_OFFICER_TOTP_SECRET=JBSWY3DPEHPK3PXP

# SMS Gateway Provider
# Supported options: "demo" (logs OTP to console), "webhook", "twilio", "fast2sms"
VIMS_SMS_PROVIDER=demo
VIMS_SMS_API_URL=https://api.sms-gateway.example.com/v1/send
VIMS_SMS_API_KEY=your_sms_api_key_here
VIMS_SMS_SENDER_ID=VIMSIN

# Transport & Vehicle Registry Integration
# Leave empty to run in demo mode (uses verified mock plates).
# If authorized, set the official government RTO / VAHAN partner API endpoint and key.
OFFICIAL_REGISTRY_API_URL=
OFFICIAL_REGISTRY_API_KEY=
OFFICIAL_REGISTRY_TIMEOUT=6.0

# Edge Video Feed (Optional RTSP or local MP4 files for ATSC junction streaming)
NS_VIDEO_PATH=assets/video/traffic_ns.mp4
EW_VIDEO_PATH=assets/video/traffic_ew.mp4
